# Songnado environment overrides.
#
# Copy to `.env.local` (gitignored) and tweak for your dev build.
# Production App Store builds ship with all of these UNSET (defaults apply).

# Re-enable Spotify Connect features in setup + game flow.
# Default (unset / 'false'): pure Deezer experience.
# Set to 'true' for personal/family dev builds where the user has been added
# to the Spotify Dashboard's 25-user development-mode allowlist.
EXPO_PUBLIC_SPOTIFY_ENABLED=true
